# Caddyfile for PT. Veritasindo Citra Abadi
# Static site with automatic HTTPS.

vca-batam.id {
	# Folder on the VPS where the site files live
	root * /var/www/veritasindo

	# Compress responses (faster loading)
	encode gzip zstd

	# Serve .vcf (contact card) with the right MIME type so phones
	# show the "Add to Contacts" prompt instead of raw text
	@vcf path *.vcf
	header @vcf Content-Type "text/vcard; charset=utf-8"

	# Serve the static files (auto-serves index.html from each folder)
	file_server

	# Cache static assets for a year (images, video, css, js)
	@static {
		path *.webp *.png *.jpg *.jpeg *.mp4 *.css *.js *.woff *.woff2
	}
	header @static Cache-Control "public, max-age=31536000, immutable"

	# Friendly 404 fallback (optional): if a path isn't found, show homepage
	# handle_errors {
	# 	rewrite * /index.html
	# 	file_server
	# }
}

# Redirect www -> non-www (keeps one canonical URL, good for SEO)
www.vca-batam.id {
	redir https://vca-batam.id{uri} permanent
}
